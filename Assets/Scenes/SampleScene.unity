      m_Calls: []
  m_text: "\t\tAugust 14, 2070\n   Log entry, David here again. The AI has invited
    us to the generator room to show us the results of its work. The mechanic is
    close now; he should be here tomorrow. Speaking of people, I thought I saw someone
    who looked like Mike through the window, but I\u2019m probably just losing my
    mind. I hasn\u2019t seen anyone other than my fellow astronauts in a good few
    days."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 4ebc437ae59a32342a2e3252f4569657, type: 2}
