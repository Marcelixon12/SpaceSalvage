  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\t      August 14, 2070\n   Log entry. This is David, the Second-in-Command,
    checking in this time, not Mike. I am writing because nobody has seen Mike for
    about three hours now. The entire crew has started searching for our commander.
    We asked the AI for the camera footage, but for some unknown reason, it refuses
    to reveal it. Instead, it suddenly repaired our generator and the ship's oxygen
    system. Regardless, we still request that the mechanic arrives to double-check
    if everything is functioning properly."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
